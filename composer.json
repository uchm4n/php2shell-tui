{
    "name": "php2scan/php2scan",
    "description": "Multi-host exposure scanner for PHP2Shell and general web misconfiguration",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "aidantwoods/secureheaders": "^2.0.1",
        "guzzlehttp/guzzle": "^8.3",
        "php-tui/php-tui": "^0.2.1",
        "symfony/console": "^7.0",
        "symfony/dom-crawler": "^7.0",
        "symfony/yaml": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11"
    },
    "autoload": {
        "psr-4": {
            "Php2Scan\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Php2Scan\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/php2scan"
    ],
    "scripts": {
        "build": [
            "@php -r \"if (!is_file('build/box.phar')) { @mkdir('build', 0777, true); if (!copy('https://github.com/box-project/box/releases/download/4.7.0/box.phar', 'build/box.phar')) { fwrite(STDERR, 'Box download failed'.PHP_EOL); exit(1); } }\"",
            "@php -d phar.readonly=0 build/box.phar compile"
        ],
        "scan": "bin/php2scan",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
