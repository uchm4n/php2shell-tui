{
    "$schema": "https://json.schemastore.org/box.json",
    "main": "bin/php2shell-tui",
    "output": "php2shell-tui",
    "chmod": "0755",
    "check-requirements": false,
    "directories": [
        "src/Data"
    ],
    "files": [
        "vendor/symfony/console/Command/SignalableCommandInterface.php"
    ],
    "force-autodiscovery": true,
    "blacklist": [
        "tests",
        "reports",
        "build",
        "docs",
        ".superpowers",
        ".opencode",
        ".idea",
        ".phpunit.cache",
        "php2shell-tui.yaml"
    ]
}
